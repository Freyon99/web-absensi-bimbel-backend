# Production Environment Variables
# Copy to .env.production and fill in the values
# DO NOT commit this file with real secrets!

# Database - Supabase Transaction Pooler (port 6543)
# Get from: Supabase Dashboard → Settings → Database → Connection string → Transaction pooler
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Redis - Upstash (free tier: 10k commands/day, 256MB)
# Get from: Upstash Console → Database Details → Redis URL
REDIS_URL="redis://default:[PASSWORD]@[HOST].upstash.io:6379"

# JWT Secret - Generate with: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"

# App
NODE_ENV="production"
PORT="3000"
HOSTNAME="0.0.0.0"

# Optional: OpenTelemetry (disable for free tier to save resources)
OTEL_ENABLED="false"
# OTEL_PROMETHEUS_PORT="9464"

# Optional: Rate limit tuning (default: 5 req / 15 min per IP)
# RATE_LIMIT_WINDOW_MS="900000"
# RATE_LIMIT_MAX_REQUESTS="5"

# Optional: Log level (debug, info, warn, error)
LOG_LEVEL="info"

# Optional: Allowed origins for CORS (comma-separated)
# ALLOWED_ORIGINS="https://your-frontend.vercel.app,https://your-domain.com"