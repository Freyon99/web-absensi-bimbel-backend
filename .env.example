# Salin file ini menjadi `.env` lalu isi nilai aslinya.
# Jangan pernah meng-commit `.env`.

# URL koneksi Postgres (Supabase). Dipakai Prisma.
DATABASE_URL=

# Lingkungan: development | production
NODE_ENV=development

# Kunci rahasia untuk menandatangani JWT sesi. Minimal 32 karakter acak.
JWT_SECRET=

# Opsional: daftar origin yang boleh membuka next dev, dipisah koma.
# Contoh: ALLOWED_DEV_ORIGINS=192.168.2.120,127.0.0.1
ALLOWED_DEV_ORIGINS=
