{
  "buildCommand": "npm run prisma:generate && npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install --loglevel=error",
  "framework": "nextjs",
  "regions": ["sin1"],
  "functions": {
    "app/api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "env": {
    "NODE_VERSION": "22"
  }
}
